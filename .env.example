# Copy this file to .env and fill in your values.
# Shell environment variables always take precedence over this file.

# ── Identity ─────────────────────────────────────────────────────────────────
SLEEPER_USERNAME=GronkQuixote

# Pin a specific league ID (takes precedence over SLEEPER_LEAGUE_MATCH).
# SLEEPER_LEAGUE_ID=

# Name fragment matched against your leagues; ignored when SLEEPER_LEAGUE_ID is set.
SLEEPER_LEAGUE_MATCH=chrysoloras

# ── Season ───────────────────────────────────────────────────────────────────
SLEEPER_SEASON=2026
# SLEEPER_STATS_SEASON=2025

# ── Dashboard ────────────────────────────────────────────────────────────────
# SLEEPER_WEB_HOST=127.0.0.1
# SLEEPER_WEB_PORT=8080
# SLEEPER_POLL_LIVE=30
# SLEEPER_POLL_IDLE=900
# SLEEPER_POLL_DRAFT=12   # poll seconds while your league's draft is live

# ── Radar / history ──────────────────────────────────────────────────────────
# Hours of league-wide add/drop volume behind the "buzz" column.
# SLEEPER_TRENDING_LOOKBACK=24

# Player cache and the daily snapshot database (snapshots.sqlite3) both live here.
# SLEEPER_CACHE_DIR=~/.cache/sleeper-mcp

# Betting lines come from ESPN's core API (no key required) and feed a ±2.5 pt
# swing in the composite ranking. Nothing to configure; listed here for clarity.
